# Configuración para Render

# API Keys
GEMINI_API_KEY=tu_clave_api_gemini_aqui

# Django Security
SECRET_KEY=tu_secret_key_segura_aqui
DEBUG=False

# Hosts permitidos (agregar URL de Render)
ALLOWED_HOSTS=localhost,127.0.0.1,tu-app.onrender.com

# CORS y CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://tu-app.onrender.com

# SSL (habilitar en producción)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
